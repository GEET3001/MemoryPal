{
  "manifest_version": 3,
  "name": "MemoryPal",
  "version": "1.0.0",
  "description": "Save anything to MemoryPal in one click — your AI-powered second brain.",
  "permissions": ["activeTab", "contextMenus", "storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to MemoryPal"
  },
  "background": {
    "service_worker": "background.js"
  }
}
